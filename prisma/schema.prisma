generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                       String            @id @default(cuid())
  name                     String?
  email                    String?           @unique
  emailVerified            DateTime?
  image                    String?
  role                     Role              @default(CLIENT)
  hashedPassword           String?
  status                   UserStatus        @default(ACTIVE)
  impersonatingUserId      String?
  referralSource           String?
  createdAt                DateTime          @default(now())
  updatedAt                DateTime          @default(now()) @updatedAt
  emailVerificationExpires DateTime?
  emailVerificationToken   String?
  passwordResetExpires     DateTime?
  passwordResetToken       String?
  referralBonus            Float             @default(0)
  referralBonusConverted   Float             @default(0)
  referralCode             String            @unique @default(cuid())
  referredByCode           String?
  bio                      String?
  adminRole                String?
  phone                    String?           @unique
  accounts                 Account[]
  cart                     Cart?
  designViews              DesignView[]
  feedback                 Feedback[]
  folders                  Folder[]
  loginHistory             LoginHistory[]
  sentMessages             Message[]
  notifications            Notification[]
  orders                   Order[]
  projects                 Project[]
  adminFeedback            ProjectFeedback[] @relation("AdminFeedback")
  clientFeedback           ProjectFeedback[] @relation("ClientFeedback")
  reviews                  Review[]
  sessions                 Session[]
  referrer                 User?             @relation("ReferredBy", fields: [referredByCode], references: [referralCode])
  referredUsers            User[]            @relation("ReferredBy")
  conversations            Conversation[]    @relation("ConversationUsers")
  wishlist                 Design[]          @relation("DesignToUser")
  readMessages             Message[]         @relation("ReadMessages")
}

model Cart {
  id             String     @id @default(cuid())
  userId         String     @unique
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  discountAmount Float?
  discountCode   String?
  discountId     String?
  discount       Discount?  @relation(fields: [discountId], references: [id])
  user           User       @relation(fields: [userId], references: [id])
  items          CartItem[]
}

model CartItem {
  id                String   @id @default(cuid())
  cartId            String
  designId          String
  quantity          Int      @default(1)
  createdAt         DateTime @default(now())
  selectedExtras    Json?
  selectedFileTypes String[]
  selectedPackage   String[]
  cart              Cart     @relation(fields: [cartId], references: [id])
  design            Design   @relation(fields: [designId], references: [id], onDelete: Cascade)

  @@unique([cartId, designId, selectedFileTypes, selectedPackage, selectedExtras])
}

model LoginHistory {
  id        String   @id @default(cuid())
  userId    String
  createdAt DateTime @default(now())
  ipAddress String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                       String  @id @default(cuid())
  userId                   String
  type                     String
  provider                 String
  providerAccountId        String
  refresh_token            String?
  access_token             String?
  expires_at               Int?
  token_type               String?
  scope                    String?
  id_token                 String?
  session_state            String?
  refresh_token_expires_in Int?
  user                     User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Category {
  id         String   @id @default(cuid())
  name       String   @unique
  image      String?
  isFeatured Boolean  @default(false)
  designs    Design[]
}

model Folder {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId    String
  designs   Design[]
  user      User     @relation(fields: [userId], references: [id])
}

model Design {
  id                       String           @id @default(cuid())
  name                     String
  description              String
  createdAt                DateTime         @default(now())
  updatedAt                DateTime         @updatedAt
  categoryId               String?
  basePrice                Float
  priceRange               String
  area                     Float?
  bathrooms                Int?
  bedrooms                 Int?
  floors                   Int?
  folderId                 String?
  planDetails              String[]
  views                    Int              @default(0)
  buildingCostEstimates    Json[]
  faq                      Json[]
  isFeatured               Boolean          @default(false)
  maxBuildingCost          Float?
  minBuildingCost          Float?
  buildingCostFactors      Json?
  architecturalCadPrice    Float?           @default(0)
  architecturalPdfPrice    Float?           @default(0)
  billOfQuantitiesPrice    Float?           @default(0)
  structuralCadPrice       Float?           @default(0)
  structuralPdfPrice       Float?           @default(0)
  billOfQuantitiesPdfPrice Float?           @default(0)
  cartItems                CartItem[]
  category                 Category?        @relation(fields: [categoryId], references: [id])
  folder                   Folder?          @relation(fields: [folderId], references: [id])
  discounts                DesignDiscount[]
  architecturalDesign      DesignDocuments? @relation("ArchitecturalDesign")
  billOfQuantities         DesignDocuments? @relation("BillOfQuantities")
  structuralDesign         DesignDocuments? @relation("StructuralDesign")
  designViews              DesignView[]
  floorPlans               File[]           @relation("DesignFloorPlans")
  files                    File[]
  images                   File[]           @relation("DesignImages")
  orderItems               OrderItem[]
  packageOptions           PackageOption[]
  reviews                  Review[]
  wishlistedBy             User[]           @relation("DesignToUser")
}

model DesignDocuments {
  id                    String       @id @default(cuid())
  type                  DocumentType
  description           String?
  overview              String?
  features              String[]
  specifications        Json?
  architecturalDesignId String?      @unique
  structuralDesignId    String?      @unique
  billOfQuantitiesId    String?      @unique
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt
  design                Design?      @relation("ArchitecturalDesign", fields: [architecturalDesignId], references: [id], onDelete: Cascade)
  billOfQuantities      Design?      @relation("BillOfQuantities", fields: [billOfQuantitiesId], references: [id], onDelete: Cascade)
  structuralDesign      Design?      @relation("StructuralDesign", fields: [structuralDesignId], references: [id], onDelete: Cascade)
  cadFiles              File[]       @relation("CadDocuments")
  excelFiles            File[]       @relation("ExcelDocuments")
  pdfFiles              File[]       @relation("PdfDocuments")
}

model File {
  id                String           @id @default(cuid())
  url               String
  type              FileType
  designId          String?
  createdAt         DateTime         @default(now())
  cadDocumentId     String?
  excelDocumentId   String?
  name              String
  pdfDocumentId     String?
  size              Int?
  designFloorPlanId String?
  designImageId     String?
  fileIdentifier    String?
  isLatest          Boolean          @default(true)
  version           Int              @default(1)
  deliveredFiles    DeliveredFile[]
  cadDocument       DesignDocuments? @relation("CadDocuments", fields: [cadDocumentId], references: [id])
  designFloorPlan   Design?          @relation("DesignFloorPlans", fields: [designFloorPlanId], references: [id], onDelete: Cascade)
  design            Design?          @relation(fields: [designId], references: [id], onDelete: Cascade)
  designImage       Design?          @relation("DesignImages", fields: [designImageId], references: [id], onDelete: Cascade)
  excelDocument     DesignDocuments? @relation("ExcelDocuments", fields: [excelDocumentId], references: [id])
  pdfDocument       DesignDocuments? @relation("PdfDocuments", fields: [pdfDocumentId], references: [id])
  packageOption     PackageOption?
  status            UploadStatus     @default(COMPLETED)
}

model Review {
  id        String   @id @default(cuid())
  rating    Int
  comment   String
  authorId  String
  designId  String
  createdAt DateTime @default(now())
  author    User     @relation(fields: [authorId], references: [id])
  design    Design   @relation(fields: [designId], references: [id], onDelete: Cascade)
}

model Testimonial {
  id        String   @id @default(cuid())
  author    String
  quote     String
  image     String?
  createdAt DateTime @default(now())
}

model Post {
  id        String   @id @default(cuid())
  title     String
  content   String
  excerpt   String?
  image     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  author    String?
}

model Order {
  id             String      @id @default(cuid())
  userId         String
  createdAt      DateTime    @default(now())
  amount         Float
  status         OrderStatus @default(PENDING)
  paymentGateway String?
  paymentId      String?     @unique
  discountAmount Float?
  discountCode   String?
  discountId     String?
  cartId         String?     @unique
  discount       Discount?   @relation(fields: [discountId], references: [id])
  user           User        @relation(fields: [userId], references: [id])
  items          OrderItem[]
}

model OrderItem {
  id                String          @id @default(cuid())
  orderId           String
  designId          String
  quantity          Int
  selectedExtras    Json?
  selectedFileTypes String[]
  deliveredFiles    DeliveredFile[]
  design            Design          @relation(fields: [designId], references: [id], onDelete: Cascade)
  order             Order           @relation(fields: [orderId], references: [id])
}

model DeliveredFile {
  id          String    @id @default(cuid())
  orderItemId String
  fileId      String
  createdAt   DateTime  @default(now())
  file        File      @relation(fields: [fileId], references: [id])
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@unique([orderItemId, fileId])
}

model Project {
  id                String               @id @default(cuid())
  name              String
  description       String?
  imageUrl          String?
  progress          Int                  @default(0)
  userId            String
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  completionRemarks String?
  declaration       Boolean              @default(false)
  totalCost         Float                @default(0)
  status            ProjectStatus        @default(PLANNING)
  invoices          Invoice[]
  user              User                 @relation(fields: [userId], references: [id])
  costs             ProjectCost[]
  feedback          ProjectFeedback[]
  milestones        ProjectMilestone[]
  requirements      ProjectRequirement[]
}

model ReferralVisit {
  id        String   @id @default(cuid())
  source    String
  createdAt DateTime @default(now())
}

model Notification {
  id          String   @id @default(cuid())
  icon        String
  title       String
  description String
  createdAt   DateTime @default(now())
  read        Boolean  @default(false)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CustomDesignRequest {
  id          String                    @id @default(cuid())
  name        String
  email       String
  phone       String?
  designType  String
  description String
  budget      String?
  attachments String[]
  createdAt   DateTime                  @default(now())
  status      CustomDesignRequestStatus @default(PENDING)
  updatedAt   DateTime                  @default(now()) @updatedAt
}

model Conversation {
  id        String    @id @default(cuid())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  messages  Message[]
  users     User[]    @relation("ConversationUsers")
}

model Message {
  id             String       @id @default(cuid())
  createdAt      DateTime     @default(now())
  content        String
  conversationId String
  senderId       String
  attachments    Attachment[]
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  sender         User         @relation(fields: [senderId], references: [id])
  readBy         User[]       @relation("ReadMessages")
}

model Attachment {
  id        String   @id @default(cuid())
  url       String
  type      String
  name      String
  messageId String
  createdAt DateTime @default(now())
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
}

model MarqueeItem {
  id        String   @id @default(cuid())
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Banner {
  id          String   @id @default(cuid())
  description String
  image       String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  title       String
}

model Discount {
  id                String           @id @default(cuid())
  code              String           @unique
  type              DiscountType
  value             Float
  minPurchaseAmount Float?
  maxUses           Int?
  uses              Int              @default(0)
  expiresAt         DateTime?
  isActive          Boolean          @default(true)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  carts             Cart[]
  designs           DesignDiscount[]
  orders            Order[]
}

model DesignDiscount {
  designId   String
  discountId String
  design     Design   @relation(fields: [designId], references: [id], onDelete: Cascade)
  discount   Discount @relation(fields: [discountId], references: [id])

  @@id([designId, discountId])
}

model NewsletterSubscription {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

model Feedback {
  id         String   @id @default(cuid())
  rating     Int
  category   String
  feedback   String
  createdAt  DateTime @default(now())
  userId     String?
  isFeatured Boolean  @default(false)
  user       User?    @relation(fields: [userId], references: [id])
}

model ProjectMilestone {
  id            String          @id @default(cuid())
  projectId     String
  name          String
  description   String?
  dueDate       DateTime
  completedDate DateTime?
  status        MilestoneStatus @default(PENDING)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  project       Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model ProjectRequirement {
  id          String            @id @default(cuid())
  projectId   String
  description String
  status      RequirementStatus @default(PENDING)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  project     Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model ProjectFeedback {
  id        String   @id @default(cuid())
  projectId String
  clientId  String
  adminId   String?
  message   String
  rating    Int?
  createdAt DateTime @default(now())
  admin     User?    @relation("AdminFeedback", fields: [adminId], references: [id])
  client    User     @relation("ClientFeedback", fields: [clientId], references: [id])
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model ProjectCost {
  id           String   @id @default(cuid())
  projectId    String
  description  String
  amount       Float
  dateIncurred DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model Invoice {
  id            String        @id @default(cuid())
  projectId     String
  invoiceNumber String        @unique
  issueDate     DateTime      @default(now())
  dueDate       DateTime
  totalAmount   Float
  status        InvoiceStatus @default(PENDING)
  type          InvoiceType   @default(CUSTOM)
  documentUrl   String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  project       Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  invoiceItems  InvoiceItem[]
}

model InvoiceItem {
  id          String   @id @default(cuid())
  invoiceId   String
  description String
  quantity    Int
  unitPrice   Float
  total       Float
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

model MonthlyCost {
  id           String   @id @default(cuid())
  month        DateTime @unique
  digitalOcean Float
  resendEmails Float
  hosting      Float
  total        Float
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model DesignView {
  id        String   @id @default(cuid())
  designId  String
  userId    String?
  createdAt DateTime @default(now())
  design    Design   @relation(fields: [designId], references: [id], onDelete: Cascade)
  user      User?    @relation(fields: [userId], references: [id])
}

model OngoingProject {
  id                      String          @id @default(cuid())
  title                   String
  slug                    String          @unique
  description             String?
  clientName              String?
  location                String?
  status                  ProjectStatus   @default(PLANNING)
  category                ProjectCategory
  startDate               DateTime?
  estimatedCompletionDate DateTime?
  completedAt             DateTime?
  featuredImage           String?
  gallery                 Json?
  size                    String?
  value                   String?
  highlights              String[]
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt
  published               Boolean         @default(false)

  @@map("ongoing_projects")
}

model PackageOption {
  id       String  @id @default(cuid())
  name     String
  price    Float
  fileId   String? @unique
  designId String
  design   Design  @relation(fields: [designId], references: [id], onDelete: Cascade)
  file     File?   @relation(fields: [fileId], references: [id])
}

enum DocumentType {
  ARCHITECTURAL
  STRUCTURAL
  BILL_OF_QUANTITIES
}

enum FileType {
  PDF
  CAD
  EXCEL
  IMAGE
  OTHER
  FLOOR_PLAN
  FILE
}

enum UploadStatus {
  UPLOADING
  COMPLETED
  FAILED
}

enum Role {
  CLIENT
  TEAM
  ADMIN
}

enum UserStatus {
  ACTIVE
  BLOCKED
}

enum OrderStatus {
  PENDING
  PAID
  REFUND_REQUESTED
  REFUNDED
}

enum CustomDesignRequestStatus {
  PENDING
  IN_REVIEW
  APPROVED
  REJECTED
  COMPLETED
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

enum ProjectStatus {
  PLANNING
  IN_PROGRESS
  COMPLETED
  ON_HOLD
  CANCELLED
  NEARING_COMPLETION
}

enum MilestoneStatus {
  PENDING
  COMPLETED
  OVERDUE
}

enum RequirementStatus {
  PENDING
  MET
  NOT_MET
}

enum InvoiceStatus {
  PENDING
  PAID
  OVERDUE
  CANCELLED
}

enum InvoiceType {
  INITIAL
  MILESTONE
  FINAL
  CUSTOM
}

enum ProjectCategory {
  RESIDENTIAL
  COMMERCIAL
  INDUSTRIAL
  RENOVATION
  INFRASTRUCTURE
  INTERIOR_FIT_OUT
}
