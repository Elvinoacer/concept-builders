// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                       String            @id @default(cuid())
  name                     String?
  email                    String?           @unique
  emailVerified            DateTime?
  image                    String?
  hashedPassword           String?
  accounts                 Account[]
  sessions                 Session[]
  orders                   Order[]
  projects                 Project[]
  role                     Role              @default(CLIENT)
  reviews                  Review[]
  wishlist                 Design[]
  folders                  Folder[]
  status                   UserStatus        @default(ACTIVE)
  loginHistory             LoginHistory[]
  impersonatingUserId      String?
  referralSource           String?
  emailVerificationToken   String?
  emailVerificationExpires DateTime?
  passwordResetToken       String?
  passwordResetExpires     DateTime?
  createdAt                DateTime          @default(now())
  updatedAt                DateTime          @default(now()) @updatedAt
  cart                     Cart?
  notifications            Notification[]
  conversations            Conversation[]    @relation("ConversationUsers")
  sentMessages             Message[]
  readMessages             Message[]         @relation("ReadMessages")
  feedback                 Feedback[]
  clientFeedback           ProjectFeedback[] @relation("ClientFeedback")
  adminFeedback            ProjectFeedback[] @relation("AdminFeedback")
  designViews              DesignView[]
  bio                      String?
  adminRole                String?
  // Referral System Fields
  referralCode             String            @unique @default(cuid()) // Now required
  referredByCode           String?
  referralBonus            Float             @default(0)
  referralBonusConverted   Float             @default(0)

  // New self-referencing relation for referred users
  referredUsers            User[]            @relation("ReferredBy") // Users referred by this user
  referrer                 User?             @relation("ReferredBy", fields: [referredByCode], references: [referralCode]) // The user who referred this user
}

model Cart {
  id             String     @id @default(cuid())
  user           User       @relation(fields: [userId], references: [id])
  userId         String     @unique
  items          CartItem[]
  discountCode   String?
  discountAmount Float?
  discountId     String?
  discount       Discount?  @relation(fields: [discountId], references: [id])
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
}

model CartItem {
  id               String   @id @default(cuid())
  cart             Cart     @relation(fields: [cartId], references: [id])
  cartId           String
  design           Design   @relation(fields: [designId], references: [id])
  designId         String
  quantity         Int      @default(1)
  createdAt        DateTime @default(now())
  selectedFileType String?
  selectedPackage  String?
  selectedExtras   Json?

  @@unique([cartId, designId, selectedFileType, selectedPackage, selectedExtras])
}

model LoginHistory {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  ipAddress String
}

model Account {
  id                       String  @id @default(cuid())
  userId                   String
  type                     String
  provider                 String
  providerAccountId        String
  refresh_token            String? @db.Text
  access_token             String? @db.Text
  expires_at               Int?
  refresh_token_expires_in Int?
  token_type               String?
  scope                    String?
  id_token                 String? @db.Text
  session_state            String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Category {
  id         String   @id @default(cuid())
  name       String   @unique
  image      String?
  designs    Design[]
  isFeatured Boolean  @default(false)
}

model Folder {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  designs   Design[]
  userId    String
  user      User     @relation(fields: [userId], references: [id])
}

model Design {
  id          String   @id @default(cuid())
  name        String
  description String
  basePrice   Float
  priceRange  String
  bedrooms    Int?
  bathrooms   Int?
  area        Float?
  floors      Int?
  
  // Organized file structure
  architecturalDesign DesignDocuments? @relation("ArchitecturalDesign")
  structuralDesign    DesignDocuments? @relation("StructuralDesign")
  billOfQuantities    DesignDocuments? @relation("BillOfQuantities")
  
  planDetails String[]
  images      File[]   @relation("DesignImages")
  floorPlans  File[]   @relation("DesignFloorPlans")
  files       File[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  folder      Folder?  @relation(fields: [folderId], references: [id])
  folderId    String?

  buildingCostEstimates Json[]
  minBuildingCost       Float?
  maxBuildingCost       Float?
  faq                   Json[]
  
  // Pricing for different packages
  architecturalPdfPrice Float? @default(0)
  architecturalCadPrice Float? @default(0)
  structuralPdfPrice    Float? @default(0)
  structuralCadPrice    Float? @default(0)
  billOfQuantitiesPrice Float? @default(0)
  packageOptions        PackageOption[]
  buildingCostFactors   Json?

  wishlistedBy User[]
  category     Category?        @relation(fields: [categoryId], references: [id])
  categoryId   String?
  reviews      Review[]
  orderItems   OrderItem[]
  cartItems    CartItem[]
  views        Int              @default(0)
  isFeatured   Boolean          @default(false)
  discounts    DesignDiscount[]
  designViews  DesignView[]
}

// New model to organize design documents by type
model DesignDocuments {
  id          String   @id @default(cuid())
  type        DocumentType // ARCHITECTURAL, STRUCTURAL, BILL_OF_QUANTITIES
  description String?  // Overview of what this document package contains
  
  // File references
  pdfFiles    File[]   @relation("PdfDocuments")
  cadFiles    File[]   @relation("CadDocuments")
  excelFiles  File[]   @relation("ExcelDocuments")
  
  // Overview/content description
  overview    String?
  features    String[]
  specifications Json? // Can store structured spec data
  
  design      Design?   @relation(name: "ArchitecturalDesign", fields: [architecturalDesignId], references: [id], onDelete: Cascade)
  architecturalDesignId String? @unique
  structuralDesign      Design?   @relation(name: "StructuralDesign", fields: [structuralDesignId], references: [id], onDelete: Cascade)
  structuralDesignId String? @unique
  billOfQuantities      Design?   @relation(name: "BillOfQuantities", fields: [billOfQuantitiesId], references: [id], onDelete: Cascade)
  billOfQuantitiesId String? @unique

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum DocumentType {
  ARCHITECTURAL
  STRUCTURAL 
  BILL_OF_QUANTITIES
}

// Updated File model to support document types
model File {
  id          String   @id @default(cuid())
  name        String
  url         String
  type        FileType
  size        Int?
  
  // Relations to different document types
  pdfDocument    DesignDocuments? @relation("PdfDocuments", fields: [pdfDocumentId], references: [id])
  pdfDocumentId  String?
  
  cadDocument    DesignDocuments? @relation("CadDocuments", fields: [cadDocumentId], references: [id])
  cadDocumentId  String?
  
  excelDocument  DesignDocuments? @relation("ExcelDocuments", fields: [excelDocumentId], references: [id])
  excelDocumentId String?
  
  // Existing relation to Design
  design      Design?  @relation(fields: [designId], references: [id])
  designId    String?

  designImage   Design?  @relation("DesignImages", fields: [designImageId], references: [id])
  designImageId String?

  designFloorPlan   Design?  @relation("DesignFloorPlans", fields: [designFloorPlanId], references: [id])
  designFloorPlanId String?

  packageOption   PackageOption?
  
  createdAt   DateTime @default(now())
}

enum FileType {
  PDF
  CAD
  EXCEL
  IMAGE
  FLOOR_PLAN
  OTHER
}

model Review {
  id        String   @id @default(cuid())
  rating    Int
  comment   String
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  designId  String
  design    Design   @relation(fields: [designId], references: [id])
  createdAt DateTime @default(now())
}

model Testimonial {
  id        String   @id @default(cuid())
  author    String
  quote     String
  image     String?
  createdAt DateTime @default(now())
}

model Post {
  id        String   @id @default(cuid())
  title     String
  content   String
  excerpt   String?
  image     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  author    String?
}

model Order {
  id             String      @id @default(cuid())
  userId         String
  user           User        @relation(fields: [userId], references: [id])
  cartId         String?     @unique // New field to link to cart
  createdAt      DateTime    @default(now())
  items          OrderItem[]
  status         OrderStatus @default(PENDING)
  amount         Float
  paymentGateway String?
  paymentId      String?     @unique
  discountCode   String?
  discountAmount Float?
  discountId     String?
  discount       Discount?   @relation(fields: [discountId], references: [id])
}

model OrderItem {
  id       String @id @default(cuid())
  orderId  String
  order    Order  @relation(fields: [orderId], references: [id])
  designId String
  design   Design @relation(fields: [designId], references: [id], onDelete: Cascade)
  quantity Int
}

model Project {
  id                String               @id @default(cuid())
  name              String
  description       String?
  imageUrl          String?
  progress          Int                  @default(0)
  status            ProjectStatus        @default(PLANNING)
  userId            String
  user              User                 @relation(fields: [userId], references: [id])
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  completionRemarks String?
  declaration       Boolean              @default(false)
  totalCost         Float                @default(0)
  milestones        ProjectMilestone[]
  requirements      ProjectRequirement[]
  feedback          ProjectFeedback[]
  costs             ProjectCost[]
  invoices          Invoice[]
}

enum Role {
  CLIENT
  TEAM
  ADMIN
}

enum UserStatus {
  ACTIVE
  BLOCKED
}

enum OrderStatus {
  PENDING
  PAID
  REFUND_REQUESTED
  REFUNDED
}

model ReferralVisit {
  id        String   @id @default(cuid())
  source    String
  createdAt DateTime @default(now())
}

model Notification {
  id          String   @id @default(cuid())
  icon        String
  title       String
  description String
  createdAt   DateTime @default(now())
  read        Boolean  @default(false)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CustomDesignRequest {
  id          String                    @id @default(cuid())
  name        String
  email       String
  phone       String?
  designType  String
  description String
  budget      String?
  attachments String[]
  createdAt   DateTime                  @default(now())
  updatedAt   DateTime                  @default(now()) @updatedAt
  status      CustomDesignRequestStatus @default(PENDING)
}

enum CustomDesignRequestStatus {
  PENDING
  IN_REVIEW
  APPROVED
  REJECTED
  COMPLETED
}

model Conversation {
  id        String    @id @default(cuid())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  users     User[]    @relation("ConversationUsers")
  messages  Message[]
}

model Message {
  id             String       @id @default(cuid())
  createdAt      DateTime     @default(now())
  content        String
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  conversationId String
  sender         User         @relation(fields: [senderId], references: [id])
  senderId       String
  readBy         User[]       @relation("ReadMessages")
  attachments    Attachment[] // New relation for multiple attachments
}

model Attachment {
  id        String   @id @default(cuid())
  url       String
  type      String // e.g., "image/jpeg", "application/pdf"
  name      String // Original file name
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  messageId String
  createdAt DateTime @default(now())
}

model MarqueeItem {
  id        String   @id @default(cuid())
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Banner {
  id          String   @id @default(cuid())
  title       String
  description String
  image       String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Discount {
  id                String           @id @default(cuid())
  code              String           @unique
  type              DiscountType
  value             Float
  minPurchaseAmount Float?
  maxUses           Int?
  uses              Int              @default(0)
  expiresAt         DateTime?
  isActive          Boolean          @default(true)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  orders            Order[]
  carts             Cart[] // New inverse relation
  designs           DesignDiscount[]
}

model DesignDiscount {
  design     Design   @relation(fields: [designId], references: [id])
  designId   String
  discount   Discount @relation(fields: [discountId], references: [id])
  discountId String

  @@id([designId, discountId])
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

model NewsletterSubscription {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

model Feedback {
  id         String   @id @default(cuid())
  rating     Int
  category   String
  feedback   String
  createdAt  DateTime @default(now())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  isFeatured Boolean  @default(false)
}

// New Enums
enum ProjectStatus {
  PLANNING
  IN_PROGRESS
  COMPLETED
  ON_HOLD
  CANCELLED
}

enum MilestoneStatus {
  PENDING
  COMPLETED
  OVERDUE
}

enum RequirementStatus {
  PENDING
  MET
  NOT_MET
}

enum InvoiceStatus {
  PENDING
  PAID
  OVERDUE
  CANCELLED
}

enum InvoiceType {
  INITIAL
  MILESTONE
  FINAL
  CUSTOM
}

// New Models
model ProjectMilestone {
  id            String          @id @default(cuid())
  projectId     String
  project       Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name          String
  description   String?
  dueDate       DateTime
  completedDate DateTime?
  status        MilestoneStatus @default(PENDING)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
}

model ProjectRequirement {
  id          String            @id @default(cuid())
  projectId   String
  project     Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  description String
  status      RequirementStatus @default(PENDING)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
}

model ProjectFeedback {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  clientId  String
  client    User     @relation(name: "ClientFeedback", fields: [clientId], references: [id])
  adminId   String? // Optional, if feedback can be from client to admin or vice-versa
  admin     User?    @relation(name: "AdminFeedback", fields: [adminId], references: [id])
  message   String
  rating    Int? // Optional rating
  createdAt DateTime @default(now())
}

model ProjectCost {
  id           String   @id @default(cuid())
  projectId    String
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  description  String
  amount       Float
  dateIncurred DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Invoice {
  id            String        @id @default(cuid())
  projectId     String
  project       Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  invoiceNumber String        @unique
  issueDate     DateTime      @default(now())
  dueDate       DateTime
  totalAmount   Float
  status        InvoiceStatus @default(PENDING)
  type          InvoiceType   @default(CUSTOM)
  documentUrl   String? // URL to the generated PDF invoice
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  invoiceItems  InvoiceItem[]
}

model InvoiceItem {
  id          String   @id @default(cuid())
  invoiceId   String
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description String
  quantity    Int
  unitPrice   Float
  total       Float
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model MonthlyCost {
  id             String   @id @default(cuid())
  month          DateTime // Store as first day of the month
  digitalOcean   Float
  resendEmails   Float
  hosting        Float
  total          Float
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([month]) // Ensure only one record per month
}

model DesignView {
  id        String   @id @default(cuid())
  designId  String
  design    Design   @relation(fields: [designId], references: [id], onDelete: Cascade)
  userId    String?  // Optional: if we want to track views by logged-in users
  user      User?    @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
}

model PackageOption {
  id        String   @id @default(cuid())
  name      String
  price     Float
  file      File?    @relation(fields: [fileId], references: [id])
  fileId    String?  @unique
  design    Design   @relation(fields: [designId], references: [id])
  designId  String
}

