// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  hashedPassword      String?
  accounts      Account[]
  sessions      Session[]
  orders        Order[]
  projects      Project[]
  role          Role      @default(CLIENT)
  reviews       Review[]
  wishlist      Design[]
  folders       Folder[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Category {
  id      String   @id @default(cuid())
  name    String   @unique
  image   String?
  designs Design[]
}

model Folder {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  designs   Design[]
  userId    String
  user      User     @relation(fields: [userId], references: [id])
}

model Design {
  id                    String      @id @default(cuid())
  name                  String
  description           String
  basePrice             Float
  priceRange            String
  images                Json
  renderings            Json
  floorPlanUrl          String?
  planDetails           Json
  faqs                  Json
  buildingCostEstimates Json
  reviews               Review[]
  relatedDesigns        Design[]    @relation("RelatedDesigns")
  relatedTo             Design[]    @relation("RelatedDesigns")
  tags                  Json
  fileTypes             Json
  drawingSetsOptions    Json
  calculatorOptions     Json?
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt
  categoryId            String
  category              Category    @relation(fields: [categoryId], references: [id])
  orderItems            OrderItem[]
  salesCount            Int         @default(0)
  users                 User[]
  bedrooms              Int?
  bathrooms             Int?
  area                  Int?
  floors                Int?
  folderId              String?
  folder                Folder?     @relation(fields: [folderId], references: [id])
  files                 String[]
}

model Review {
  id        String   @id @default(cuid())
  rating    Int
  comment   String
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  designId  String
  design    Design   @relation(fields: [designId], references: [id])
  createdAt DateTime @default(now())
}

model Testimonial {
  id        String   @id @default(cuid())
  author    String
  quote     String
  image     String?
  createdAt DateTime @default(now())
}

model Post {
  id        String   @id @default(cuid())
  title     String
  content   String
  excerpt   String?
  image     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  author    String?
}

model Order {
  id        String      @id @default(cuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id])
  createdAt DateTime    @default(now())
  items     OrderItem[]
  status    OrderStatus @default(PENDING)
  amount    Float
}

model OrderItem {
  id       String @id @default(cuid())
  orderId  String
  order    Order  @relation(fields: [orderId], references: [id])
  designId String
  design   Design @relation(fields: [designId], references: [id])
  quantity Int
}

model Project {
  id          String   @id @default(cuid())
  name        String
  description String?
  imageUrl    String?
  progress    Int      @default(0)
  status      String   @default("Planning")
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum Role {
  CLIENT
  TEAM
  ADMIN
}

enum OrderStatus {
  PENDING
  PAID
  REFUND_REQUESTED
  REFUNDED
}